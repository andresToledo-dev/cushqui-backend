{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "regions": ["dub1"],
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/**/*.js",
      "maxDuration": 30
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}

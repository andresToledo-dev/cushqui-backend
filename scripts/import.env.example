# Copy to scripts/import.env (git-ignored) and fill in.
# Used only by scripts/import-transactions.ts

# Local API (the script refuses any host other than localhost / 127.0.0.1)
IMPORT_API_URL=http://localhost:3000/api/v1

# User that will own every imported account, category and transaction (created if missing, with INVITATION_CODE)
IMPORT_EMAIL=user@example.com
IMPORT_PASSWORD=change-me-Aa1!
IMPORT_USER_NAME=Import
# Only needed if the user does not exist yet: registration is invitation-only (npm run invite:dev <email>)
INVITATION_CODE=

# Excel to import (can also be passed with --file)
IMPORT_SOURCE_FILE=C:\path\to\Transactions.xlsx

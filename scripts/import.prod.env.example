# Copy to scripts/import.prod.env (git-ignored) and fill in.
# Used only by: npm run import:prod / import:prod:execute / import:prod:resume <runId>

# Production API (must be https)
IMPORT_API_URL=https://cushqui-backend.vercel.app/api/v1

# Your production user. It must ALREADY EXIST: register it in the app first.
# The script never creates users in production.
IMPORT_EMAIL=you@example.com
IMPORT_PASSWORD=change-me-Aa1!

# Excel to import
IMPORT_SOURCE_FILE=C:\path\to\Transactions.xlsx
